# Copy to .env and fill in after checking invocable models in your account:
#   aws bedrock list-foundation-models --by-provider anthropic --region <region>
#   aws bedrock list-inference-profiles --region <region>
#
# COMPLIANCE_BEDROCK_REGION=us-east-1
# COMPLIANCE_BEDROCK_MODEL=<invocable-model-or-inference-profile-id>
#
# Default offline demos do not need AWS. Checklist confirmation verifies without Bedrock.
